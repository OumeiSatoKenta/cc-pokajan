{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    // @types/react が DOM の型を参照するため、UI のレンダリングテスト用に DOM を含める。
    "lib": ["ES2023", "DOM"],
    // UI テストが取り込む src/App.tsx は CSS を side-effect import するため、
    // その型宣言を持つ vite/client が必要（tsconfig.app.json と揃える）。
    "types": ["node", "vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },

  /*
   * tsconfig.app.json への references は意図的に張っていない。
   * Vite テンプレートは composite を使わない noEmit 構成のため、
   * リーフ間で references を張ると TS6306 / TS6310 で tsc -b が失敗する。
   * tests/ は src/ を相対パスで import しており、その解決結果がこのプロジェクトの
   * プログラムに取り込まれるので、references なしでも型検査は効いている。
   */
  "include": ["tests"]
}
